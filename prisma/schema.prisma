// ============================================================================
// CCOFACT PRO - CORPORACIÓN CCOPLEX S.A.C.
// ESQUEMA OFICIAL DE BASE DE DATOS EXCLUSIVO CON PRISMA ORM (100% SOBERANO)
// ============================================================================
// Motor Soberano de Facturación Electrónica SUNAT UBL 2.1
// Base de Datos: PostgreSQL 18
// Control de Concurrencia: Bloqueo Pesimista (SELECT ... FOR UPDATE) y Colas SKIP LOCKED
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// MODELO: USER (USUARIOS Y ACCESOS AL FACTURADOR - MULTI-TENANT RBAC)
// ----------------------------------------------------------------------------
model User {
  id             String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  email          String    @unique @db.VarChar(150)
  password_hash  String    @db.VarChar(255)
  name           String    @db.VarChar(150)
  role           String    @default("ADMIN") @db.VarChar(50)
  company_id     String?   @db.Uuid
  is_active      Boolean   @default(true)
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  updated_at     DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  company        Company?  @relation(fields: [company_id], references: [id], onDelete: SetNull)

  @@index([company_id], map: "IDX_users_company_id")
  @@map("users")
}

// ----------------------------------------------------------------------------
// MODELO: COMPANY (EMPRESAS EMISORAS - MULTI-TENANT ISOLATION)
// ----------------------------------------------------------------------------
model Company {
  id                      String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  ruc                     String        @unique @db.VarChar(11)
  razon_social            String        @db.VarChar(255)
  nombre_comercial        String?       @db.VarChar(255)
  direccion               String        @db.VarChar(255)
  ubigeo                  String        @default("150101") @db.VarChar(6)
  departamento            String        @default("LIMA") @db.VarChar(100)
  provincia               String        @default("LIMA") @db.VarChar(100)
  distrito                String        @default("LIMA") @db.VarChar(100)
  urbanizacion            String?       @default("-") @db.VarChar(100)
  email                   String?       @db.VarChar(150)
  telefono                String?       @db.VarChar(50)
  logo_url                String?       @db.Text
  sol_user                String        @default("MODDATOS") @db.VarChar(100)
  sol_pass                String        @default("moddatos") @db.VarChar(100)
  certificate_pfx_base64  String?       @db.Text
  certificate_password    String?       @db.VarChar(255)
  certificate_filename    String?       @db.VarChar(500)
  certificate_url         String?       @db.VarChar(1000)
  certificate_expires_at  DateTime?     @db.Timestamptz(6)
  certificate_subject     String?       @db.Text
  certificate_issuer      String?       @db.Text
  env_mode                String        @default("BETA") @db.VarChar(20)
  api_key                 String        @unique(map: "IDX_143c7390478a2c2de3ee21bed0") @db.VarChar(128)
  webhook_url             String?       @db.VarChar(500)
  is_active               Boolean       @default(true)
  created_at              DateTime      @default(now()) @db.Timestamptz(6)
  updated_at              DateTime      @default(now()) @updatedAt @db.Timestamptz(6)

  // Relaciones Multi-Tenant
  branches                Branch[]
  series_list             Series[]
  documents               Document[]
  jobs                    InvoiceJob[]
  users                   User[]

  @@map("companies")
}

// ----------------------------------------------------------------------------
// MODELO: BRANCH (ESTABLECIMIENTOS ANEXOS / SUCURSALES SUNAT)
// ----------------------------------------------------------------------------
model Branch {
  id                    String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  company_id            String        @db.Uuid
  code                  String        @default("0000") @db.VarChar(10)
  name                  String        @db.VarChar(150)
  address               String        @db.VarChar(255)
  ubigeo                String        @default("150101") @db.VarChar(6)
  is_active             Boolean       @default(true)
  created_at            DateTime      @default(now()) @db.Timestamptz(6)

  company               Company       @relation(fields: [company_id], references: [id], onDelete: Cascade)
  series_list           Series[]
  documents             Document[]

  @@map("branches")
}

// ----------------------------------------------------------------------------
// MODELO: SERIES (CONTROL ATÓMICO DE CORRELATIVOS FISCALES)
// ----------------------------------------------------------------------------
model Series {
  id                    String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  company_id            String        @db.Uuid
  branch_id             String?       @db.Uuid
  document_type         String        @db.VarChar(2)
  series                String        @db.VarChar(4)
  current_number        Int           @default(0)
  is_active             Boolean       @default(true)
  created_at            DateTime      @default(now()) @db.Timestamptz(6)
  updated_at            DateTime      @default(now()) @updatedAt @db.Timestamptz(6)

  company               Company       @relation(fields: [company_id], references: [id], onDelete: Cascade)
  branch                Branch?       @relation(fields: [branch_id], references: [id], onDelete: SetNull)

  @@unique([company_id, document_type, series], map: "IDX_bdc811820134900859ef243d6d")
  @@map("series")
}

// ----------------------------------------------------------------------------
// MODELO: DOCUMENT (COMPROBANTES DE PAGO ELECTRÓNICOS - CPE)
// ----------------------------------------------------------------------------
model Document {
  id                    String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  company_id            String          @db.Uuid
  branch_id             String?         @db.Uuid
  idempotency_key       String?         @db.VarChar(100)
  document_type         String          @db.VarChar(2)
  series                String          @db.VarChar(4)
  number                Int
  full_number           String          @db.VarChar(20)
  issue_date            String          @db.VarChar(10)
  issue_time            String          @db.VarChar(8)
  due_date              String?         @db.VarChar(10)
  currency              String          @default("PEN") @db.VarChar(3)
  operation_type        String          @default("0101") @db.VarChar(4)
  payment_type          String          @default("Contado") @db.VarChar(20)
  payment_terms         Json?
  client_doc_type       String          @db.VarChar(1)
  client_doc_number     String          @db.VarChar(15)
  client_name           String          @db.VarChar(255)
  client_address        String?         @db.VarChar(255)
  client_email          String?         @db.VarChar(150)
  total_gravada         Decimal         @default(0) @db.Decimal(12, 2)
  total_exonerada       Decimal         @default(0) @db.Decimal(12, 2)
  total_inafecta        Decimal         @default(0) @db.Decimal(12, 2)
  total_gratuita        Decimal         @default(0) @db.Decimal(12, 2)
  total_igv             Decimal         @default(0) @db.Decimal(12, 2)
  total_isc             Decimal         @default(0) @db.Decimal(12, 2)
  total_icbper          Decimal         @default(0) @db.Decimal(12, 2)
  total_descuentos      Decimal         @default(0) @db.Decimal(12, 2)
  total_cargos          Decimal         @default(0) @db.Decimal(12, 2)
  subtotal              Decimal         @default(0) @db.Decimal(12, 2)
  total_amount          Decimal         @default(0) @db.Decimal(12, 2)
  ref_document_type     String?         @db.VarChar(2)
  ref_series            String?         @db.VarChar(4)
  ref_number            Int?
  ref_reason_code       String?         @db.VarChar(2)
  ref_reason_desc       String?         @db.VarChar(255)
  xml_digest_value      String?         @db.VarChar(64)
  xml_signature_value   String?
  qr_data               String?
  xml_content           String?
  cdr_xml               String?
  cdr_zip_base64        String?
  status                String          @default("DRAFT") @db.VarChar(25)
  sunat_response_code   String?         @db.VarChar(20)
  sunat_description     String?
  sunat_notes           Json?
  sunat_sent_at         DateTime?       @db.Timestamptz(6)
  sunat_response_at     DateTime?       @db.Timestamptz(6)
  metadata              Json?
  created_at            DateTime        @default(now()) @db.Timestamptz(6)
  updated_at            DateTime        @default(now()) @updatedAt @db.Timestamptz(6)

  company               Company         @relation(fields: [company_id], references: [id], onDelete: Cascade)
  branch                Branch?         @relation(fields: [branch_id], references: [id], onDelete: SetNull)
  items                 DocumentItem[]
  jobs                  InvoiceJob[]

  @@unique([company_id, idempotency_key], map: "IDX_009cb4855f6ace7dc0b3f4f53e")
  @@unique([company_id, document_type, series, number], map: "IDX_d1e42394011a043d2c12d82a66")
  @@map("documents")
}

// ----------------------------------------------------------------------------
// MODELO: DOCUMENT_ITEM (LÍNEAS DE DETALLE DE PRODUCTOS O SERVICIOS)
// ----------------------------------------------------------------------------
model DocumentItem {
  id                    String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  document_id           String        @db.Uuid
  item_order            Int
  code                  String?       @db.VarChar(50)
  description           String        @db.VarChar(500)
  unit_measure          String        @default("NIU") @db.VarChar(5)
  quantity              Decimal       @db.Decimal(12, 4)
  unit_value            Decimal       @db.Decimal(12, 4)
  unit_price            Decimal       @db.Decimal(12, 4)
  igv_affectation_type  String        @default("10") @db.VarChar(2)
  igv_percentage        Decimal       @default(18) @db.Decimal(5, 2)
  igv_amount            Decimal       @default(0) @db.Decimal(12, 2)
  subtotal              Decimal       @default(0) @db.Decimal(12, 2)
  total                 Decimal       @default(0) @db.Decimal(12, 2)

  document              Document      @relation(fields: [document_id], references: [id], onDelete: Cascade)

  @@index([document_id], map: "IDX_914af31366f94d9e241b25622a")
  @@map("document_items")
}

// ----------------------------------------------------------------------------
// MODELO: INVOICE_JOB (COLAS TRANSACCIONALES CON SKIP LOCKED)
// ----------------------------------------------------------------------------
model InvoiceJob {
  id                    String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  company_id            String        @db.Uuid
  document_id           String        @db.Uuid
  job_type              String        @default("SEND_BILL") @db.VarChar(30)
  status                String        @default("PENDING") @db.VarChar(20)
  payload               Json?
  attempts              Int           @default(0)
  max_attempts          Int           @default(5)
  next_run_at           DateTime      @default(now()) @db.Timestamptz(6)
  locked_at             DateTime?     @db.Timestamptz(6)
  locked_by             String?       @db.VarChar(100)
  last_error            String?
  created_at            DateTime      @default(now()) @db.Timestamptz(6)
  updated_at            DateTime      @default(now()) @updatedAt @db.Timestamptz(6)

  company               Company       @relation(fields: [company_id], references: [id], onDelete: Cascade)
  document              Document      @relation(fields: [document_id], references: [id], onDelete: Cascade)

  @@index([status, next_run_at], map: "IDX_5b7a62f93812c5c9169420c2bd")
  @@map("invoice_jobs")
}
